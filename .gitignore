# Jekyll build output and caches
_site/
.jekyll-cache/
.jekyll/
.jekyll-metadata
.sass-cache/

# Ruby/Bundler
.bundle/
vendor/bundle/
# Gemfile.lock is intentionally committed: this is a site, not a gem, and CI
# must resolve the same gem versions we build with locally.

# Node (if you add any tooling)
node_modules/

# OS files
.DS_Store
Thumbs.db

# Editors/IDEs
.idea/
.vscode/
*.iml

# Logs and temp files
*.log
*.tmp
.cache/

# Env files (if you ever add secrets for local testing)
.env
.env.*
