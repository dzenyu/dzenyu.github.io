---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allTags, slugifyKey } from "../../utils/taxonomy";

const posts = await getCollection("blog");
const tags = [...allTags(posts).entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags" description="Browse all posts by tag.">
  <div class="prose">
    <h1>Tags</h1>
    <ul class="tag-cloud">
      {tags.map(([tag, count]) => (
        <li>
          <a href={`/tags/${slugifyKey(tag)}/`}>{tag} <span class="count">({count})</span></a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
