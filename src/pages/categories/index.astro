---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allTopLevelCategories, slugifyKey } from "../../utils/taxonomy";

const posts = await getCollection("blog");
const categories = [...allTopLevelCategories(posts).entries()].sort((a, b) =>
  a[0].localeCompare(b[0]),
);
---

<BaseLayout title="Categories" description="Browse all posts by top-level category.">
  <div class="prose">
    <h1>Categories</h1>
    <ul class="category-list">
      {categories.map(([category, count]) => (
        <li>
          <a href={`/categories/${slugifyKey(category)}/`}>
            {category} <span class="count">({count})</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
