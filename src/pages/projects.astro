---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Project {
  name: string;
  description: string;
  stack: string[];
  role: string;
  links: { label: string; url: string }[];
}

const projects: Project[] = [
  {
    name: "AttendOnTime",
    description:
      "Event registration, ticketing, communications, and real-time check-in platform designed for live events.",
    stack: ["Spring Boot", "GraphQL Federation", "Kafka", "PostgreSQL", "AWS"],
    role: "Founder & Lead Architect",
    links: [
      { label: "Visit AttendOnTime", url: "https://attendontime.com" },
      { label: "Read the story", url: "/2026/01/18/building-attendontime/" },
    ],
  },
  {
    name: "Next-Gen E911 Location Delivery Platform",
    description:
      "NG911 platform serving real-time emergency caller location data, architected with a read/write path separation between provisioning and low-latency delivery, synced via change data capture and compliant with NENA i3 (HELD, PIDF-LO) and FCC mandates.",
    stack: ["Java 21", "Spring Boot", "Spring Batch", "Oracle", "Redis", "Debezium / RDI", "NENA i3"],
    role: "Technical Leader",
    links: [
      { label: "Read the story", url: "/2026/09/20/architecting-nextgen-e911-location-delivery/" },
    ],
  },
];
---

<BaseLayout title="Projects" description="Things I've built, architected, or helped bring to production.">
  <h1>Projects</h1>
  <p class="page-intro">Things I've built, architected, or helped bring to production.</p>

  <ul class="project-grid">
    {projects.map((project) => (
      <li class="project-card">
        <h2>{project.name}</h2>
        <p class="description">{project.description}</p>
        <p class="role">{project.role}</p>
        <p class="stack">
          {project.stack.map((tech) => <span>{tech}</span>)}
        </p>
        <div class="project-links">
          {project.links.map((link) => (
            <a class="button" href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}>
              {link.label}
            </a>
          ))}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
