---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostListItem from "../components/PostListItem.astro";
import { sortByDateDesc } from "../utils/taxonomy";

const posts = sortByDateDesc(await getCollection("blog")).slice(0, 8);
---

<BaseLayout>
  <p>
    Hi, I am <strong>Dzenyu Samuel Mukangara</strong> — a Principal Software Engineer who
    thrives on turning complex requirements into simple, resilient, and maintainable
    systems. I share architecture insights, coding practices, and engineering
    leadership lessons from building resilient, high-throughput microservices.
  </p>

  <h2>Recent posts</h2>
  <ul class="post-list">
    {posts.map((post) => <PostListItem post={post} />)}
  </ul>

  <p><a href="/blog/">Browse all posts &rarr;</a></p>
</BaseLayout>
