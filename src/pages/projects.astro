---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Project {
  name: string;
  description: string;
  stack: string[];
  role: string;
  links: { label: string; url: string }[];
}

const projects: Project[] = [
  {
    name: "AttendOnTime",
    description:
      "Event registration, ticketing, and real-time check-in platform, built to replace manual guest-list chaos at live events.",
    stack: ["Spring Boot", "GraphQL", "Kafka", "PostgreSQL", "AWS"],
    role: "Founder & Architect",
    links: [
      { label: "Visit AttendOnTime", url: "https://attendontime.com" },
      { label: "Read the story", url: "/2026/01/18/building-attendontime/" },
    ],
  },
];
---

<BaseLayout title="Projects" description="Things I've built, architected, or helped bring to production.">
  <h1>Projects</h1>
  <p class="page-intro">Things I've built, architected, or helped bring to production.</p>

  <ul class="project-grid">
    {projects.map((project) => (
      <li class="project-card">
        <h2>{project.name}</h2>
        <p class="description">{project.description}</p>
        <p class="stack">
          {project.stack.map((tech) => <span>{tech}</span>)}
        </p>
        <p class="role">{project.role}</p>
        <div class="project-links">
          {project.links.map((link) => (
            <a class="button" href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}>
              {link.label}
            </a>
          ))}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
